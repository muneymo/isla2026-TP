    "# get the observed values to predict\n",
    "y = df[['long']]\n",
    "# fit a multiple linear regression model\n",
    "lr = LinearRegression()\n",
    "lr.fit(X, y)\n",
    "\n",
    "# get the coefficients\n",
    "beta_vector2 = lr.coef_\n",
    "beta_vector2\n"
